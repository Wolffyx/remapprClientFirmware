/*
 * Output nRF — Remappr shield (generated by remappr).
 *
 * Drop this directory into a remappr-firmware checkout under
 * boards/shields/output_nrf/ and build with -Dremappr_SHIELD=output_nrf. Verify the
 * row/col GPIO specs against your wiring — remappr derives the matrix
 * cells from physical key position, not the electrical matrix.
 *
 * SPDX-License-Identifier: Apache-2.0
 */

#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/input/keymap.h>
#include <dt-bindings/remappr/keys.h>
#include <dt-bindings/remappr/layout.h>
#include <remappr/keymap-tokens.dtsi>
#include <remappr/behavior-tokens.dtsi>
#include <zephyr/dt-bindings/led/led.h>
#include <zephyr/dt-bindings/pwm/pwm.h>
#include <dt-bindings/remappr/sensor.h>

/ {
	kbd_matrix: kbd-matrix {
		compatible = "remappr,kbd-matrix";
		diode-direction = "col2row";
		poll-period-ms = <1>;
		sleep-poll-period-ms = <20>;
		settle-time-us = <30>;
		debounce-press-mode = "defer";
		debounce-press-ms = <5>;
		debounce-release-ms = <10>;
		row-gpios =
			<&gpio0 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
		col-gpios =
			<&gpio1 1 GPIO_ACTIVE_HIGH>,
			<&gpio1 2 GPIO_ACTIVE_HIGH>;

		keymap {
			compatible = "input-keymap";
			keymap = <
				MATRIX_KEY(0, 0, REMAPPR_KB_POS_BASE + 0) MATRIX_KEY(0, 1, REMAPPR_KB_POS_BASE + 1)
			>;
			row-size = <1>;
			col-size = <2>;
		};
	};

	remappr_keymap: remappr-keymap {
		compatible = "remappr,keymap";
		scan = <&kbd_matrix>;
		columns = <2>;
		rows = <2>;
		max-layers = <4>;
		placement = <
				KEY(&x 0 &y 0) KEY(&x 1 &y 0)
		>;
		layer_0 {
			compatible = "remappr,keymap-layer";
			index = <0>;
			actions = <
				&key 0x04 &key 0x05
			>;
		};
	};
};

&pinctrl {
	spi3_default: spi3_default {
		group1 {
			psels = <NRF_PSEL(SPIM_MOSI, 1, 13)>;
		};
	};
	spi3_sleep: spi3_sleep {
		group1 {
			psels = <NRF_PSEL(SPIM_MOSI, 1, 13)>;
			low-power-enable;
		};
	};
};

&spi3 {
	compatible = "nordic,nrf-spim";
	status = "okay";
	pinctrl-0 = <&spi3_default>;
	pinctrl-1 = <&spi3_sleep>;
	pinctrl-names = "default", "sleep";

	led_strip: ws2812@0 {
		compatible = "worldsemi,ws2812-spi";
		reg = <0>;
		spi-max-frequency = <4000000>;
		chain-length = <12>;
		/* One low lead-in bit, then the pulse: 4000000 Hz SPI clock. */
		spi-one-frame = <0x70>;
		spi-zero-frame = <0x40>;
		color-mapping = <LED_COLOR_ID_GREEN LED_COLOR_ID_RED LED_COLOR_ID_BLUE>;
	};
};

/ {
	chosen {
		/* Runtime RGB service renders the per-key map / effects here. */
		remappr,led-strip = &led_strip;
	};
};

&uart1 {
	current-speed = <1000000>;
	status = "okay";
};

/ {
	node_bus_0: node_bus_0 {
		compatible = "remappr,node-bus-port";
		uart = <&uart1>;
		direction = "downstream";
	};
};

/ {
	remappr_haptic: haptic {
		compatible = "remappr,haptic";
		pwms = <&pwm0 0 20000000 PWM_POLARITY_NORMAL>;
	};
};

/ {
	backlight_zone: zone_0 {
		compatible = "remappr,led-zone";
		target = "backlight";
		offset = <0>;
		length = <8>;
	};
	indicator_zone: zone_1 {
		compatible = "remappr,led-zone";
		target = "indicator";
		offset = <8>;
		length = <4>;
	};
};

&i2c0 {
	status = "okay";
	clock-frequency = <400000>;

	display_panel_0: ssd1306fb@3c {
		compatible = "solomon,ssd1306fb";
		reg = <0x3c>;
		width = <128>;
		height = <32>;
		segment-offset = <0>;
		page-offset = <0>;
		display-offset = <0>;
		multiplex-ratio = <31>;
		prechargep = <34>;
		segment-remap;
		com-invdir;
		com-sequential;
	};
};

/ {
	display_0: display_0 {
		compatible = "remappr,display";
		display = <&display_panel_0>;
	};
};
