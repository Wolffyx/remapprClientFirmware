{
  "schemaVersion": 1,
  "kind": "remappr.keymap",
  "meta": { "name": "Buttons nRF", "target": "zmk" },
  "keyboard": {
    "id": "buttons_nrf",
    "name": "Buttons nRF",
    "keys": [
      { "x": 0, "y": 0 },
      { "x": 1, "y": 0 },
      { "x": 2, "y": 0, "w": 2 }
    ]
  },
  "layers": [
    { "name": "base", "bindings": ["A", "B", "ENTER"] },
    { "name": "fn", "bindings": ["1", "2", "3"] }
  ],
  "node": { "personality": "keyboard" },
  "board": {
    "controller": "nrf52840dk/nrf52840",
    "buttons": [
      { "key": 0, "pin": "P1.01" },
      { "key": 1, "pin": "P1.02" },
      { "key": 2, "pin": "P1.03", "code": "INPUT_KEY_ENTER" }
    ]
  }
}
